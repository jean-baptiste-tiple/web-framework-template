---
import { SECTION_REGISTRY, type AnySection } from '@/lib/sections';

interface Props {
  // Toutes les variantes du registre, chrome compris (la galerie /styleguide les
  // prévisualise ici). Ce qu'une PAGE peut demander est borné en amont par
  // l'union Zod `sectionSchema`, qui exclut le chrome.
  section: AnySection;
}
const { section } = Astro.props;

// Table `type` → composant, lue dans le registre (src/lib/sections.ts) :
// ce fichier ne bouge plus quand une section est ajoutée.
const Component = SECTION_REGISTRY[section.type].component;
---

<Component section={section as never} />
