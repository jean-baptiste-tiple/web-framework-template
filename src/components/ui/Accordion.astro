---
// Accordéon natif : 0 JS, contenu dans le DOM au repos (donc crawlable et
// trouvable au Ctrl+F même replié). Squelette canonique <details>/<summary> du
// socle — Faq.astro en est le premier consommateur.
// `min-h-11` sur le <summary> (2,75rem = 44px, échelle Tailwind) : plancher de
// cible tactile du craft-floor. Sans lui, un libellé d'UNE ligne ne mesure que
// 27px de haut (mesuré à 390) ; un libellé de deux lignes dépasse déjà 44px, sa
// densité ne bouge donc pas. `items-center` recentre libellé et chevron dedans.
import Icon from './Icon.astro';

interface Props {
  summary: string;
  /** Attribut natif `name` : les <details> qui le partagent s'excluent (un seul ouvert). */
  name?: string;
  /** Ouvert au chargement (contenu visible sans script) : famille de la fiche courante dans le menu de /styleguide. */
  open?: boolean;
  /** `plain` = sans cadre ni marge intérieure, pour une liste de volets serrés
      (familles du menu de /styleguide) ; défaut `boxed` = volet encadré. */
  variant?: 'boxed' | 'plain';
  class?: string;
}
const { summary, name, open = false, variant = 'boxed', class: cls = '' } = Astro.props;
const frame = variant === 'boxed' ? 'rounded border border-border p-4' : '';
---

<details name={name} open={open} class={`group ${frame} ${cls}`}>
  <summary
    class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [&::-webkit-details-marker]:hidden"
  >
    {summary}
    {/* Le triangle natif est remplacé par le chevron du jeu d'icônes :
        `list-none` + le marqueur WebKit (aucun utilitaire Tailwind ne le cible). */}
    <Icon
      name="chevron-down"
      class="text-muted transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none"
    />
  </summary>
  <slot />
</details>
