---
// [starter forms] Formulaire de contact statique, sans îlot ni framework.
// Poste vers un service tiers (Formspree, Web3Forms…) défini par
// PUBLIC_FORM_ENDPOINT — inliné AU BUILD : définir la variable dans
// l'environnement de build de l'hébergeur, pas seulement en local.
import Button from './Button.astro';

interface Props {
  /** Préfixe des id/for : deux formulaires sur la même page dupliqueraient sinon
      `id="name"`, et un `<label for>` viserait le mauvais champ. */
  idPrefix?: string;
}
const { idPrefix = 'contact' } = Astro.props;

// La couleur du texte saisi est POSÉE, pas héritée : un champ `bg-bg` sans couleur
// propre, posé sous une bande `text-inverse-fg` (Card tone="inverse", hero de page
// contact), rendrait du texte blanc sur fond blanc. Les libellés, eux, héritent bien
// de la bande. Ratios sur bg : fg 17,59:1 (seuil 4,5), muted 5,35:1 (seuil 4,5).
const field =
  'w-full rounded border border-border bg-bg px-3 py-2 text-sm text-fg placeholder:text-muted';
---

<form data-contact-form class="space-y-4">
  <!-- Honeypot anti-spam : si rempli, on ignore silencieusement. -->
  <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

  <div>
    <label class="mb-1 block text-sm font-medium" for={`${idPrefix}-name`}>Nom</label>
    <input id={`${idPrefix}-name`} name="name" type="text" required class={field} />
  </div>
  <div>
    <label class="mb-1 block text-sm font-medium" for={`${idPrefix}-email`}>Email</label>
    <input id={`${idPrefix}-email`} name="email" type="email" required class={field} />
  </div>
  <div>
    <label class="mb-1 block text-sm font-medium" for={`${idPrefix}-message`}>Message</label>
    <textarea id={`${idPrefix}-message`} name="message" required rows={5} class={field}></textarea>
  </div>

  <Button type="submit">Envoyer</Button>

  <p data-status="ok" role="status" hidden class="text-sm text-green-600">
    Message envoyé, merci.
  </p>
  <p data-status="error" role="alert" hidden class="text-sm text-red-600"></p>
</form>

<script>
  const ENDPOINT = import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined;

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const ok = form.querySelector<HTMLElement>('[data-status="ok"]');
    const err = form.querySelector<HTMLElement>('[data-status="error"]');

    const showError = (msg: string) => {
      if (ok) ok.hidden = true;
      if (err) {
        err.textContent = msg;
        err.hidden = false;
      }
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      if (data.get('_gotcha')) return; // honeypot rempli → bot

      if (!ENDPOINT) {
        showError('PUBLIC_FORM_ENDPOINT non configuré (voir .env.example).');
        return;
      }

      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Envoi…';
      }
      if (err) err.hidden = true;

      try {
        const res = await fetch(ENDPOINT, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.reset();
          if (ok) ok.hidden = false;
        } else {
          showError('Une erreur est survenue. Réessayez.');
        }
      } catch {
        showError('Une erreur est survenue. Réessayez.');
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Envoyer';
        }
      }
    });
  });
</script>
