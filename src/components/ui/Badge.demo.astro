---
import type { DemoDoc } from '@/lib/styleguide';
import DemoCase from '@/components/styleguide/DemoCase.astro';
import Badge from './Badge.astro';
import Icon from './Icon.astro';

export const demo: DemoDoc = {
  name: 'Étiquette en pilule',
};
---

<div class="space-y-8">
  <DemoCase label="neutre · accentuée · avec icône">
    <div class="flex flex-wrap items-center gap-3">
      <Badge>Guide</Badge>
      <Badge tone="accent">Nouveau</Badge>
      <Badge tone="accent"><Icon name="sparkles" size={14} />Avec icône</Badge>
    </div>
  </DemoCase>
  <DemoCase label="sur fond sombre" surface="inverse">
    <Badge tone="inverse">Sur bande sombre</Badge>
  </DemoCase>
</div>
