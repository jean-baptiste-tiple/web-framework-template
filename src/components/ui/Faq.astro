---
// FAQ = données (paires q/a) + titre. Le squelette <details>/<summary> n'est PAS
// réécrit ici : il vient d'Accordion.astro (surface canonique de l'accordéon).
import Accordion from './Accordion.astro';

interface Props {
  title?: string;
  items: { q: string; a: string }[];
}
const { title = 'Questions fréquentes', items } = Astro.props;
---

{
  items.length > 0 && (
    <div class="space-y-3">
      {title && <h2 class="text-xl font-semibold">{title}</h2>}
      {items.map((item) => (
        <Accordion summary={item.q}>
          <p class="mt-2 text-muted">{item.a}</p>
        </Accordion>
      ))}
    </div>
  )
}
