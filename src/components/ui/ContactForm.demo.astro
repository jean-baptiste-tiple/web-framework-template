---
import type { DemoDoc } from '@/lib/styleguide';
import DemoCase from '@/components/styleguide/DemoCase.astro';
import ContactForm from './ContactForm.astro';

export const demo: DemoDoc = {
  name: 'Formulaire nom, email, message',
};
---

<div class="space-y-8">
  <DemoCase label="par défaut">
    <ContactForm idPrefix="demo" />
  </DemoCase>
  <DemoCase label="sur fond sombre · libellé du bouton changé" surface="inverse">
    <ContactForm idPrefix="demo-inverse" tone="inverse" submitLabel="Envoyer ma demande" />
  </DemoCase>
</div>
