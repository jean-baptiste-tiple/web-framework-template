---
import type { DemoDoc } from '@/lib/styleguide';
import DemoCase from '@/components/styleguide/DemoCase.astro';
import ContactForm from './ContactForm.astro';

export const demo: DemoDoc = {
  name: 'Formulaire de contact',
  purpose: 'Nom, email et message envoyés au service de réception du site, sans quitter la page.',
  ask: 'Ajoute le formulaire de contact en bas de la page Audit énergétique, avec le bouton « Envoyer ma demande ».',
};
---

<div class="space-y-8">
  <DemoCase label="par défaut">
    <ContactForm idPrefix="demo" />
  </DemoCase>
  <DemoCase label="tone inverse · submitLabel « Envoyer ma demande »" surface="inverse">
    <ContactForm idPrefix="demo-inverse" tone="inverse" submitLabel="Envoyer ma demande" />
  </DemoCase>
</div>
