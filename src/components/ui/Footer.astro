---
import { SITE } from '@/lib/site';
import Container from './Container.astro';
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-border py-8 text-sm text-muted">
  <Container class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {SITE.organization.name}</p>
    <nav class="flex gap-4">
      <a href="/mentions-legales" class="hover:text-fg">Mentions légales</a>
      <a href="/rss.xml" class="hover:text-fg">RSS</a>
    </nav>
  </Container>
</footer>
