---
import { SITE } from '@/lib/site';
import { getAuthor } from '@/lib/authors';

type PageType = 'website' | 'article' | 'page' | 'service';

interface FaqItem {
  q: string;
  a: string;
}
interface Crumb {
  name: string;
  url: string;
}

interface Props {
  type: PageType;
  url: string; // canonical
  title: string;
  description: string;
  authorKey?: string;
  pubDate?: Date;
  updatedDate?: Date;
  image?: string;
  serviceName?: string;
  serviceType?: 'Service' | 'Product';
  serviceProvider?: string;
  faq?: FaqItem[];
  breadcrumbs?: Crumb[];
}

const {
  type,
  url,
  title,
  description,
  authorKey,
  pubDate,
  updatedDate,
  image,
  serviceName,
  serviceType,
  serviceProvider,
  faq,
  breadcrumbs,
} = Astro.props;

const orgId = `${SITE.url}#organization`;
const siteId = `${SITE.url}#website`;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': orgId,
    name: SITE.organization.name,
    // Champ attendu par les scanners agentiques (is-agentic) au même titre que name.
    description: SITE.description,
    url: SITE.url,
    logo: new URL(SITE.organization.logo, SITE.url).href,
    ...(SITE.organization.sameAs.length
      ? { sameAs: SITE.organization.sameAs }
      : {}),
    // contactPoint et address : champs que les scanners agentiques cherchent
    // pour vérifier la légitimité de l'éditeur (un Organization sans moyen de
    // contact ni adresse compte comme incomplet). Émis seulement si renseignés
    // dans site.json, comme sameAs — un site sans coordonnées reste valide.
    ...(SITE.contact?.email ? { email: SITE.contact.email } : {}),
    ...(SITE.contact?.phone ? { telephone: SITE.contact.phone } : {}),
    ...(SITE.contact
      ? {
          contactPoint: [
            {
              '@type': 'ContactPoint',
              contactType: SITE.contact.contactType,
              ...(SITE.contact.email ? { email: SITE.contact.email } : {}),
              ...(SITE.contact.phone ? { telephone: SITE.contact.phone } : {}),
              availableLanguage: [SITE.lang],
            },
          ],
        }
      : {}),
    ...(SITE.address
      ? {
          address: {
            '@type': 'PostalAddress',
            ...(SITE.address.streetAddress
              ? { streetAddress: SITE.address.streetAddress }
              : {}),
            ...(SITE.address.postalCode
              ? { postalCode: SITE.address.postalCode }
              : {}),
            addressLocality: SITE.address.addressLocality,
            ...(SITE.address.addressRegion
              ? { addressRegion: SITE.address.addressRegion }
              : {}),
            addressCountry: SITE.address.addressCountry,
          },
        }
      : {}),
  },
  {
    '@type': 'WebSite',
    '@id': siteId,
    name: SITE.name,
    url: SITE.url,
    inLanguage: SITE.locale,
    publisher: { '@id': orgId },
  },
];

if (type === 'article') {
  const author = authorKey ? getAuthor(authorKey) : undefined;
  graph.push({
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: title,
    description,
    inLanguage: SITE.locale,
    url,
    mainEntityOfPage: url,
    ...(image ? { image } : {}),
    ...(pubDate ? { datePublished: pubDate.toISOString() } : {}),
    dateModified: (updatedDate ?? pubDate ?? new Date()).toISOString(),
    ...(author
      ? {
          author: {
            '@type': 'Person',
            name: author.name,
            ...(author.url ? { url: author.url } : {}),
            ...(author.sameAs?.length ? { sameAs: author.sameAs } : {}),
          },
        }
      : {}),
    publisher: { '@id': orgId },
  });
} else if (type === 'service') {
  // Service OU Product selon le frontmatter (schema.type de la landing).
  const schemaType = serviceType ?? 'Service';
  graph.push({
    '@type': schemaType,
    name: serviceName ?? title,
    description,
    url,
    ...(schemaType === 'Product'
      ? {
          brand: {
            '@type': 'Brand',
            name: serviceProvider ?? SITE.organization.name,
          },
        }
      : {
          provider: serviceProvider
            ? { '@type': 'Organization', name: serviceProvider }
            : { '@id': orgId },
        }),
  });
} else if (type === 'page') {
  graph.push({
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    name: title,
    description,
    url,
    inLanguage: SITE.locale,
    isPartOf: { '@id': siteId },
    ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  });
}

if (faq && faq.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

if (breadcrumbs && breadcrumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: c.url,
    })),
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(jsonLd)}
/>
