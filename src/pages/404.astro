---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import { SITE } from '@/lib/site';

const meta = {
  title: 'Page introuvable',
  description: 'Erreur 404',
  seo: { noindex: true },
};

// Points de reprise pour un visiteur ou un agent arrivé sur une URL morte :
// la navigation du site (libellés édités dans site.json, jamais recopiés ici),
// puis les deux index machine du site. Dédoublonnage par href pour que l'accueil
// n'apparaisse pas deux fois quand `nav` le contient déjà.
const seen = new Set<string>();
const recoveryLinks = [
  ...SITE.nav,
  { label: 'Accueil', href: '/' },
  { label: 'Plan du site', href: '/sitemap.xml' },
  { label: 'Index pour agents IA', href: '/llms.txt' },
].filter((l) => {
  if (seen.has(l.href)) return false;
  seen.add(l.href);
  return true;
});
---

<BaseLayout meta={meta} type="website">
  <Container prose class="py-20">
    <h1 class="text-3xl font-bold tracking-tight">Page introuvable</h1>
    <p class="mt-3 text-muted">Cette adresse n’existe pas ou n’existe plus.</p>

    <h2 class="mt-10 text-lg font-semibold">Où chercher</h2>
    <ul class="mt-2 divide-y divide-border border-y border-border">
      {
        recoveryLinks.map((l) => (
          <li>
            <a
              href={l.href}
              class="flex min-h-11 items-center text-accent underline underline-offset-2 hover:text-fg"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-8"><Button href="/">Retour à l’accueil</Button></div>
  </Container>
</BaseLayout>
