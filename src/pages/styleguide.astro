---
// Galerie des composants UI — contrepartie exécutable du component-registry.
// noindex : page outil, ni sitemap ni llms.txt (ne pas l'ajouter aux BESPOKE).
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Faq from '@/components/ui/Faq.astro';
import SectionRenderer from '@/components/landing/SectionRenderer.astro';
import { SECTION_REGISTRY, type AnySection } from '@/lib/sections';

const meta = {
  title: 'Styleguide',
  description:
    'Galerie interne des composants UI du socle : boutons, cartes, FAQ, tokens. Page outil non indexée, réservée au développement.',
  seo: { noindex: true },
};

const tokens = ['bg', 'fg', 'muted', 'border', 'surface', 'accent'];

// Un exemple par variante du registre de sections : la galerie casse tant qu'une
// variante ajoutée n'a pas son exemple ici (Record indexé sur SectionType).
const sectionSamples: Record<keyof typeof SECTION_REGISTRY, AnySection> = {
  'nav.header-simple': {
    type: 'nav.header-simple',
    brand: 'Marque',
    nav: [
      { label: 'Accueil', href: '/' },
      { label: 'Blog', href: '/blog' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  'nav.footer-simple': {
    type: 'nav.footer-simple',
    organizationName: 'Mon Organisation',
    links: [
      { label: 'Mentions légales', href: '/mentions-legales' },
      { label: 'RSS', href: '/rss.xml' },
    ],
  },
  'offer.features-grid': {
    type: 'offer.features-grid',
    title: 'Features (grille)',
    items: [
      { title: 'Feature A', body: 'Une phrase de bénéfice.' },
      { title: 'Feature B', body: 'Une phrase de bénéfice.' },
      { title: 'Feature C', body: 'Une phrase de bénéfice.' },
    ],
  },
  'proof.testimonials-grid': {
    type: 'proof.testimonials-grid',
    title: 'Témoignages (grille)',
    items: [{ quote: 'Une citation courte.', author: 'Prénom Nom', role: 'Fonction' }],
  },
  'content.faq-accordion': {
    type: 'content.faq-accordion',
    title: 'FAQ (accordéon)',
    items: [{ q: 'Une question ?', a: 'Une réponse factuelle.' }],
  },
  'convert.cta-banner': {
    type: 'convert.cta-banner',
    title: 'Bandeau CTA',
    label: 'Appel à l’action',
    href: '#',
  },
};
---

<BaseLayout meta={meta}>
  <Section>
    <Container>
      <h1 class="text-3xl font-semibold">Styleguide</h1>
      <p class="mt-2 text-muted">
        Vérifier ici (et dans .claude/conventions/component-registry.md) avant de créer un
        composant. Tout nouveau composant ou variante s'ajoute à cette page dans le même commit.
      </p>

      <h2 class="mt-10 text-xl font-semibold">Tokens couleur</h2>
      <div class="mt-4 flex flex-wrap gap-3">
        {
          tokens.map((t) => (
            <div class="rounded border border-border p-2 text-xs">
              <div class="h-10 w-24 rounded border border-border" style={`background: var(--color-${t})`} />
              <p class="mt-1 text-muted">--color-{t}</p>
            </div>
          ))
        }
      </div>

      <h2 class="mt-10 text-xl font-semibold">Button</h2>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <Button href="#">primary</Button>
        <Button href="#" variant="outline">outline</Button>
        <Button type="submit">submit</Button>
      </div>

      <h2 class="mt-10 text-xl font-semibold">Card</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <Card>
          <h3 class="font-medium">Carte simple</h3>
          <p class="mt-1 text-sm text-muted">Surface canonique : fond, bordure, radius.</p>
        </Card>
        <Card class="hover:border-accent">
          <h3 class="font-medium">Carte cliquable</h3>
          <p class="mt-1 text-sm text-muted">Variante hover utilisée par les listes (blog, home).</p>
        </Card>
      </div>

      <h2 class="mt-10 text-xl font-semibold">Faq</h2>
      <div class="mt-4">
        <Faq
          items={[
            { q: 'Pourquoi cette page ?', a: 'Rendre le registre vérifiable d’un coup d’œil avant de créer un composant.' },
            { q: 'Est-elle indexée ?', a: 'Non : noindex, absente du sitemap et de llms.txt.' },
          ]}
        />
      </div>

      <h2 class="mt-10 text-xl font-semibold">Sections (registre)</h2>
      <p class="mt-2 text-muted">
        Variantes disponibles dans <code>sections:</code> (frontmatter des landings et des pages).
        Une variante = un dossier src/components/sections/&lt;famille&gt;/ + une entrée dans
        src/lib/sections.ts. Les variantes marquées <strong>chrome</strong> (header, footer) sont
        rendues une fois par BaseLayout depuis src/lib/chrome.ts : elles ne sont PAS proposées
        dans <code>sections:</code>.
      </p>
    </Container>

    {
      Object.entries(sectionSamples).map(([type, sample]) => (
        <div class="mt-6 border-t border-border pt-2">
          <Container>
            <p class="text-xs text-muted">
              {type}
              {'chrome' in SECTION_REGISTRY[type as keyof typeof SECTION_REGISTRY] && ' — chrome'}
            </p>
          </Container>
          <SectionRenderer section={sample} />
        </div>
      ))
    }
  </Section>
</BaseLayout>
