---
// Galerie des composants UI — contrepartie exécutable du component-registry.
// noindex : page outil, ni sitemap ni llms.txt (ne pas l'ajouter aux BESPOKE).
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import ContactForm from '@/components/ui/ContactForm.astro';
import Faq from '@/components/ui/Faq.astro';
import Accordion from '@/components/ui/Accordion.astro';
import Badge from '@/components/ui/Badge.astro';
import Icon from '@/components/ui/Icon.astro';
import { ICON_NAMES } from '@/components/ui/icons';
import SectionRenderer from '@/components/landing/SectionRenderer.astro';
import { SECTION_REGISTRY, type AnySection } from '@/lib/sections';

const meta = {
  title: 'Styleguide',
  description:
    'Galerie interne des composants UI du socle : boutons, cartes, FAQ, tokens. Page outil non indexée, réservée au développement.',
  seo: { noindex: true },
};

const tokens = [
  'bg',
  'fg',
  'muted',
  'border',
  'surface',
  'accent',
  'inverse',
  'inverse-fg',
  'inverse-muted',
];

// Un exemple par variante du registre de sections : la galerie casse tant qu'une
// variante ajoutée n'a pas son exemple ici (Record indexé sur SectionType).
const sectionSamples: Record<keyof typeof SECTION_REGISTRY, AnySection> = {
  'nav.header-simple': {
    type: 'nav.header-simple',
    brand: 'Marque',
    nav: [
      { label: 'Accueil', href: '/' },
      { label: 'Blog', href: '/blog' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  'nav.footer-simple': {
    type: 'nav.footer-simple',
    organizationName: 'Mon Organisation',
    links: [
      { label: 'Mentions légales', href: '/mentions-legales' },
      { label: 'RSS', href: '/rss.xml' },
    ],
  },
  'offer.features-grid': {
    type: 'offer.features-grid',
    title: 'Features (grille)',
    items: [
      { title: 'Feature A', body: 'Une phrase de bénéfice.' },
      { title: 'Feature B', body: 'Une phrase de bénéfice.' },
      { title: 'Feature C', body: 'Une phrase de bénéfice.' },
    ],
  },
  'proof.testimonials-grid': {
    type: 'proof.testimonials-grid',
    title: 'Témoignages (grille)',
    items: [{ quote: 'Une citation courte.', author: 'Prénom Nom', role: 'Fonction' }],
  },
  'content.faq-accordion': {
    type: 'content.faq-accordion',
    title: 'FAQ (accordéon)',
    items: [{ q: 'Une question ?', a: 'Une réponse factuelle.' }],
  },
  'convert.cta-banner': {
    type: 'convert.cta-banner',
    title: 'Bandeau CTA',
    label: 'Appel à l’action',
    href: '#',
  },
};
---

<BaseLayout meta={meta}>
  <Section>
    <Container>
      <h1 class="text-3xl font-semibold">Styleguide</h1>
      <p class="mt-2 text-muted">
        Vérifier ici (et dans .claude/conventions/component-registry.md) avant de créer un
        composant. Tout nouveau composant ou variante s'ajoute à cette page dans le même commit.
      </p>

      <h2 class="mt-10 text-xl font-semibold">Tokens couleur</h2>
      <div class="mt-4 flex flex-wrap gap-3">
        {
          tokens.map((t) => (
            <div class="rounded border border-border p-2 text-xs">
              <div class="h-10 w-24 rounded border border-border" style={`background: var(--color-${t})`} />
              <p class="mt-1 text-muted">--color-{t}</p>
            </div>
          ))
        }
      </div>

      <h2 class="mt-10 text-xl font-semibold">Button</h2>
      <p class="mt-2 text-sm text-muted">
        Tabuler jusqu'aux boutons : l'anneau de focus est explicite (accent sur page claire,
        inverse-fg sur bande sombre), jamais celui du navigateur.
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <Button href="#">primary</Button>
        <Button href="#" variant="outline">outline</Button>
        <Button type="submit">submit</Button>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-3 rounded bg-inverse p-6">
        <Button href="#" tone="inverse">primary · tone inverse</Button>
        <Button href="#" variant="outline" tone="inverse">outline · tone inverse</Button>
      </div>

      <h2 class="mt-10 text-xl font-semibold">Card</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <Card>
          <h3 class="font-medium">Carte simple</h3>
          <p class="mt-1 text-sm text-muted">Surface canonique : fond, bordure, radius.</p>
        </Card>
        <Card class="hover:border-accent">
          <h3 class="font-medium">Carte cliquable</h3>
          <p class="mt-1 text-sm text-muted">Variante hover utilisée par les listes (blog, home).</p>
        </Card>
        <Card padding="none">
          <div class="h-24 bg-border"></div>
          <div class="p-6">
            <h3 class="font-medium">padding="none"</h3>
            <p class="mt-1 text-sm text-muted">
              Surface sans gouttière : le contenu touche les bords et la carte rogne au radius.
            </p>
          </div>
        </Card>
      </div>
      <div class="mt-4 rounded bg-inverse p-6">
        <Card tone="inverse">
          <h3 class="font-medium">tone="inverse"</h3>
          <p class="mt-1 text-sm text-inverse-muted">
            Carte sombre : surface, filet et couleur de texte fixés par le ton, jamais hérités.
            Posée sur la bande, elle se lit au filet ; posée sur une page claire, c'est un encart
            appuyé.
          </p>
        </Card>
      </div>

      <h2 class="mt-10 text-xl font-semibold">ContactForm</h2>
      <p class="mt-2 text-muted">
        Sur bande sombre : les libellés héritent de la bande, mais les champs gardent leur propre
        couleur de texte (<code>text-fg</code> sur <code>bg-bg</code>). Sans elle, la saisie serait
        blanche sur champ blanc. <code>idPrefix</code> évite les <code>id</code> dupliqués quand
        deux formulaires coexistent sur une page.
      </p>
      <!-- `bg-inverse text-inverse-fg` : la bande doit poser SA couleur de texte, `bg-inverse` ne
           pose que le fond. C'est cette bande-là qui reproduisait le bug (champ sans couleur propre
           = saisie blanche sur champ blanc) ; les libellés, eux, doivent bien en hériter. -->
      <div class="mt-4 rounded bg-inverse p-6 text-inverse-fg">
        <ContactForm idPrefix="inverse" tone="inverse" />
      </div>

      <h2 class="mt-10 text-xl font-semibold">Icon</h2>
      <p class="mt-2 text-muted">
        Jeu FERMÉ, inliné (0 requête). <code>name</code> est une union littérale : un nom absent
        casse <code>astro check</code>. Décoratif par défaut (<code>aria-hidden</code>), porteur de
        sens avec <code>label</code>.
      </p>
      <div class="mt-4 grid grid-cols-3 gap-3 sm:grid-cols-6">
        {
          ICON_NAMES.map((name) => (
            <div class="flex flex-col items-center gap-2 rounded border border-border p-3">
              <Icon name={name} size={24} />
              <code class="text-center text-xs text-muted">{name}</code>
            </div>
          ))
        }
      </div>

      <h2 class="mt-10 text-xl font-semibold">Badge</h2>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <Badge>neutral</Badge>
        <Badge tone="accent">accent</Badge>
        <Badge tone="accent"><Icon name="sparkles" size={14} />avec icône</Badge>
      </div>
      <div class="mt-4 rounded bg-inverse p-6">
        <Badge tone="inverse">inverse</Badge>
      </div>

      <h2 class="mt-10 text-xl font-semibold">Accordion</h2>
      <p class="mt-2 text-muted">
        Squelette <code>&lt;details&gt;</code> canonique (0 JS, contenu dans le DOM au repos).
        <code>Faq.astro</code> en est le consommateur : ne pas réécrire ce markup dans une section.
      </p>
      <div class="mt-4 space-y-3">
        <Accordion summary="Accordion seul (indépendant)">
          <p class="mt-2 text-muted">Le contenu est un slot : texte, liste ou markup libre.</p>
        </Accordion>
      </div>
      <p class="mt-4 text-sm text-muted">
        Avec <code>name</code> partagé : ouvrir l'un referme l'autre (exclusivité native).
      </p>
      <div class="mt-2 space-y-3">
        <Accordion summary="Groupe exclusif, premier volet" name="styleguide-accordion">
          <p class="mt-2 text-muted">Ouvrir le second referme celui-ci.</p>
        </Accordion>
        <Accordion summary="Groupe exclusif, second volet" name="styleguide-accordion">
          <p class="mt-2 text-muted">Même attribut <code>name</code> que le précédent.</p>
        </Accordion>
      </div>

      <h2 class="mt-10 text-xl font-semibold">Faq</h2>
      <div class="mt-4">
        <Faq
          items={[
            { q: 'Pourquoi cette page ?', a: 'Rendre le registre vérifiable d’un coup d’œil avant de créer un composant.' },
            { q: 'Est-elle indexée ?', a: 'Non : noindex, absente du sitemap et de llms.txt.' },
          ]}
        />
      </div>

      <h2 class="mt-10 text-xl font-semibold">Sections (registre)</h2>
      <p class="mt-2 text-muted">
        Variantes disponibles dans <code>sections:</code> (frontmatter des landings et des pages).
        Une variante = un dossier src/components/sections/&lt;famille&gt;/ + une entrée dans
        src/lib/sections.ts. Les variantes marquées <strong>chrome</strong> (header, footer) sont
        rendues une fois par BaseLayout depuis src/lib/chrome.ts : elles ne sont PAS proposées
        dans <code>sections:</code>.
      </p>
    </Container>

    {
      Object.entries(sectionSamples).map(([type, sample]) => (
        <div class="mt-6 border-t border-border pt-2">
          <Container>
            <p class="text-xs text-muted">
              {type}
              {'chrome' in SECTION_REGISTRY[type as keyof typeof SECTION_REGISTRY] && ' · chrome'}
            </p>
          </Container>
          <SectionRenderer section={sample} />
        </div>
      ))
    }
  </Section>
</BaseLayout>
