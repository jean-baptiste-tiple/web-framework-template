---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { getPosts } from '@/lib/blog';

const posts = (await getPosts()).slice(0, 3);

const meta = {
  title: 'Accueil',
  description:
    'Page d’accueil du template Astro statique. Remplacer cette description par la proposition de valeur réelle du site, formulée en 140 à 160 caractères.',
};
---

<BaseLayout meta={meta} type="website">
  <PageHero eyebrow="Template Astro statique" title="Titre principal de la home">
    <Fragment slot="lead">
      Sous-titre. Cette page est en <code>.astro</code> (sur-mesure). Le blog et les pages
      éditoriales viennent de collections Markdown.
    </Fragment>
    <Fragment slot="actions">
      <Button href="/blog">Voir le blog</Button>
      <Button href="/a-propos" variant="outline">À propos</Button>
    </Fragment>
  </PageHero>

  {
    posts.length > 0 && (
      <Section>
        <Container>
          <h2 class="mb-8 text-2xl font-semibold">Derniers articles</h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <a href={`/blog/${post.id}`}>
                <Card class="h-full transition-colors hover:border-accent">
                  <h3 class="font-semibold">{post.data.title}</h3>
                  <p class="mt-1 text-sm text-muted">
                    {post.data.description}
                  </p>
                </Card>
              </a>
            ))}
          </div>
        </Container>
      </Section>
    )
  }
</BaseLayout>
