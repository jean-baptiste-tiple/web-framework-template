---
// Accueil de la bibliothèque des composants : /styleguide/ (ADR 0003).
// Page LÉGÈRE : jamais les fiches elles-mêmes (une fiche par page,
// /styleguide/<id>/, révision v2), seulement les familles et leur nombre de
// fiches. Route dynamique à un seul chemin pour N'EXISTER QUE hors production :
// un fichier styleguide.astro statique serait construit partout. Rien n'est
// listé ici : tout vient de src/lib/styleguide.ts. noindex, hors sitemap et
// llms.txt (ne pas l'ajouter aux BESPOKE).
import GalleryShell from '@/components/styleguide/GalleryShell.astro';
import Icon from '@/components/ui/Icon.astro';
import { GALLERY_ENABLED, getGallery } from '@/lib/styleguide';

export function getStaticPaths() {
  return GALLERY_ENABLED ? [{ params: { galerie: undefined } }] : [];
}

const { nav } = await getGallery();
---

<GalleryShell title="Accueil">
  <div class="px-4 py-10 sm:px-6 lg:px-10">
    <h1 class="text-3xl font-semibold tracking-tight">Bibliothèque des composants</h1>
    <p class="mt-3 max-w-reading text-muted">
      Chaque bloc et chaque élément du site, une fiche par page : son nom, son aperçu sur ordinateur
      et sur téléphone, et les pages qui l’utilisent. Pour en utiliser un, citez son nom à Claude. Cette
      bibliothèque vit sur le site de test et en local, jamais sur le site public.
    </p>
    <ul class="mt-8 max-w-reading border-t border-border">
      {
        nav.map((g) => (
          <li class="border-b border-border">
            <a
              href={g.items[0].href}
              class="flex min-h-11 items-center justify-between gap-4 py-2 hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
            >
              <span class="font-medium">{g.label}</span>
              <span class="inline-flex items-center gap-1.5 text-sm text-muted">
                {g.items.length} fiche{g.items.length > 1 && 's'}
                <Icon name="arrow-right" size={16} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</GalleryShell>
