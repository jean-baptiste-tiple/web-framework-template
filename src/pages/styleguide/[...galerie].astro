---
// Bibliothèque des composants : /styleguide/ (ADR 0003).
// Route dynamique à un seul chemin pour pouvoir N'EXISTER QUE hors production :
// un fichier styleguide.astro statique serait construit partout. Rien n'est
// listé ici : composants, sections, tokens et usages viennent de
// src/lib/styleguide.ts (démos colocalisées, @theme, graphe des imports).
// noindex, hors sitemap et llms.txt (ne pas l'ajouter aux BESPOKE).
// Pleine largeur à gouttières relatives (exception déclarée au registre) :
// l'aperçu ordinateur rend 1280 px réduits à la colonne, qui doit rester large.
// Les échantillons de tokens posent `var(--…)` en style inline : la liste des
// tokens est lue au build, aucune classe Tailwind ne peut être écrite à l'avance.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Accordion from '@/components/ui/Accordion.astro';
import Badge from '@/components/ui/Badge.astro';
import Icon from '@/components/ui/Icon.astro';
import { GALLERY_ENABLED, getGallery, type Access, type TokenGroup } from '@/lib/styleguide';

export function getStaticPaths() {
  return GALLERY_ENABLED ? [{ params: { galerie: undefined } }] : [];
}

const { groups, tokens, entries } = await getGallery();

const meta = {
  title: 'Bibliothèque des composants',
  description:
    'Tous les blocs et éléments du site, avec la phrase à dire à Claude pour les utiliser. Page outil du site de test, absente du site public.',
  seo: { noindex: true },
};

const ACCESS: Record<Access, { badge: string; tone: 'accent' | 'neutral'; note: string }> = {
  page: {
    badge: 'Vous pouvez l’ajouter seul',
    tone: 'accent',
    note: 'Dites cette phrase à Claude en l’adaptant : il pose le bloc sur la page, sur le site de test.',
  },
  global: {
    badge: 'Sur toutes les pages',
    tone: 'neutral',
    note: 'Ses textes et liens se changent seuls ; en changer le modèle, c’est du développement.',
  },
  dev: {
    badge: 'Développeur',
    tone: 'neutral',
    note: 'C’est du développement : demandez au développeur du site.',
  },
};

const swatch = (kind: TokenGroup['kind'], name: string, value: string) => {
  const v = `var(--${name}, ${value})`;
  return {
    color: `background: ${v}`,
    font: `font-family: ${v}`,
    weight: `font-weight: ${v}`,
    text: `font-size: ${v}`,
    space: `width: ${v}`,
    width: `width: ${v}`,
    radius: `border-radius: ${v}`,
    shadow: `box-shadow: ${v}`,
    value: '',
  }[kind];
};
const tokenSearch = (g: TokenGroup) => `fondations ${g.label} ${g.tokens.map((t) => t.name).join(' ')}`;
---

<BaseLayout meta={meta}>
  <div data-sg class="px-4 py-10 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-4 lg:gap-10 xl:grid-cols-5">
      <aside class="lg:col-span-1">
        <div class="lg:sticky lg:top-0 lg:max-h-screen lg:overflow-y-auto lg:py-6">
          <label for="sg-search" class="text-sm font-medium">Rechercher</label>
          <input
            id="sg-search"
            type="search"
            autocomplete="off"
            placeholder="témoignages, bouton, faq…"
            aria-describedby="sg-count"
            class="mt-1 min-h-11 w-full rounded border border-border bg-bg px-3 text-sm text-fg placeholder:text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          />
          <p id="sg-count" data-sg-count aria-live="polite" class="mt-2 text-xs text-muted">
            {entries.length} composants
          </p>

          <Accordion summary="Sommaire" open class="mt-4">
            <nav aria-label="Sommaire de la bibliothèque" class="mt-4 space-y-6">
              <div data-sg-group>
                <p class="text-xs font-semibold tracking-wide text-muted uppercase">Fondations</p>
                <ul class="mt-2">
                  {
                    tokens.map((g) => (
                      <li data-sg-item={`fondations-${g.id}`}>
                        <a
                          href={`#fondations-${g.id}`}
                          class="flex min-h-11 items-center rounded px-2 text-sm text-muted hover:bg-surface hover:text-fg focus-visible:outline-2 focus-visible:outline-accent lg:min-h-9"
                        >
                          {g.label}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
              {
                groups.map((g) => (
                  <div data-sg-group>
                    <p class="text-xs font-semibold tracking-wide text-muted uppercase">{g.label}</p>
                    <ul class="mt-2">
                      {g.entries.map((e) => (
                        <li data-sg-item={e.id}>
                          <a
                            href={`#${e.id}`}
                            class="flex min-h-11 items-center rounded px-2 text-sm text-muted hover:bg-surface hover:text-fg focus-visible:outline-2 focus-visible:outline-accent lg:min-h-9"
                          >
                            {e.doc.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </nav>
          </Accordion>
        </div>
      </aside>

      <div class="mt-10 min-w-0 lg:col-span-3 lg:mt-0 xl:col-span-4">
        <header class="max-w-reading">
          <h1 class="text-3xl font-semibold tracking-tight">Bibliothèque des composants</h1>
          <p class="mt-3 text-muted">
            Tous les blocs et éléments du site, à jour à chaque construction. Pour en utiliser un,
            copiez sa phrase « À dire à Claude », adaptez-la à votre page et envoyez-la à Claude.
          </p>
          <ul class="mt-4 space-y-2 text-sm">
            {
              (Object.keys(ACCESS) as Access[]).map((a) => (
                <li class="flex flex-wrap items-baseline gap-2">
                  <Badge tone={ACCESS[a].tone}>{ACCESS[a].badge}</Badge>
                  <span class="text-muted">{ACCESS[a].note}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-sm text-muted">
            Un bloc qui manque ici n’existe pas encore : c’est un nouveau composant à demander au
            développeur, qui l’ajoutera à cette bibliothèque. Cette page vit sur le site de test et en
            local, jamais sur le site public.
          </p>
        </header>

        <div
          class="sticky top-0 z-10 -mx-4 mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-border bg-bg/95 px-4 py-3 sm:-mx-6 sm:px-6 lg:mx-0 lg:px-0"
        >
          <span id="sg-viewport-label" class="text-sm font-medium">Aperçu</span>
          <div role="group" aria-labelledby="sg-viewport-label" class="inline-flex rounded border border-border p-0.5">
            <button
              type="button"
              data-sg-mode="desktop"
              aria-pressed="true"
              class="min-h-11 rounded-sm px-4 text-sm font-medium text-muted transition-colors hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-pressed:bg-fg aria-pressed:text-bg motion-reduce:transition-none"
            >
              Ordinateur
            </button>
            <button
              type="button"
              data-sg-mode="phone"
              aria-pressed="false"
              class="min-h-11 rounded-sm px-4 text-sm font-medium text-muted transition-colors hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-pressed:bg-fg aria-pressed:text-bg motion-reduce:transition-none"
            >
              Téléphone
            </button>
          </div>
          <p class="text-xs text-muted">Ordinateur : 1280 px, réduit à la largeur de la colonne. Téléphone : 390 px.</p>
        </div>

        <section data-sg-group aria-labelledby="fondations" class="mt-10">
          <h2 id="fondations" class="text-2xl font-semibold tracking-tight">Fondations</h2>
          <p class="mt-2 max-w-reading text-sm text-muted">
            Lues dans <code>src/styles/global.css</code> (blocs <code>@theme</code>) à chaque
            construction : couleurs, polices, tailles et rayons viennent d’ici et de nulle part ailleurs.
          </p>
          {
            tokens.map((g) => (
              <div
                id={`fondations-${g.id}`}
                data-sg-entry
                data-search={tokenSearch(g)}
                class="scroll-mt-24 border-t border-border py-8 first-of-type:mt-6"
              >
                <h3 class="text-lg font-semibold">{g.label}</h3>
                <ul
                  class={
                    g.kind === 'color'
                      ? 'mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 xl:grid-cols-5'
                      : 'mt-4 space-y-4'
                  }
                >
                  {g.tokens.map((t) => (
                    <li class="min-w-0">
                      {g.kind === 'color' && (
                        <div class="h-14 rounded border border-border" style={swatch(g.kind, t.name, t.value)} />
                      )}
                      {(g.kind === 'font' || g.kind === 'weight' || g.kind === 'text') && (
                        <p class="text-lg" style={swatch(g.kind, t.name, t.value)}>
                          Portez la voix du site, 0123456789
                        </p>
                      )}
                      {(g.kind === 'space' || g.kind === 'width') && (
                        <div class="h-3 max-w-full rounded-sm bg-accent" style={swatch(g.kind, t.name, t.value)} />
                      )}
                      {(g.kind === 'radius' || g.kind === 'shadow') && (
                        <div class="size-16 border border-border bg-surface" style={swatch(g.kind, t.name, t.value)} />
                      )}
                      <p class="mt-2 text-xs">
                        <code class="font-medium">--{t.name}</code>
                      </p>
                      <p class="text-xs break-words text-muted">{t.value}</p>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </section>

        {
          groups.map((g) => (
            <section data-sg-group class="mt-16">
              <h2 class="text-2xl font-semibold tracking-tight">{g.label}</h2>
              {g.entries.map((e) => (
                <article id={e.id} data-sg-entry data-search={e.search} class="scroll-mt-24 border-t border-border py-10 first-of-type:mt-6">
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <h3 class="text-xl font-semibold">
                      <a href={`#${e.id}`} class="underline-offset-4 hover:underline">
                        {e.doc.name}
                      </a>
                    </h3>
                    <Badge tone={ACCESS[e.access].tone}>{ACCESS[e.access].badge}</Badge>
                  </div>
                  <p class="mt-2 max-w-reading text-muted">{e.doc.purpose}</p>

                  <div class="mt-5 max-w-reading">
                    <p class="text-sm font-medium">À dire à Claude</p>
                    <div class="mt-2 flex items-start gap-3 rounded border border-border bg-surface p-3">
                      <p class="flex-1 text-sm">
                        « <span data-sg-ask>{e.doc.ask}</span> »
                      </p>
                      <button
                        type="button"
                        data-sg-copy
                        class="min-h-11 shrink-0 rounded border border-muted px-3 text-sm font-medium transition-colors hover:bg-bg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none"
                      >
                        Copier
                      </button>
                    </div>
                    <p class="mt-2 text-sm text-muted">{ACCESS[e.access].note}</p>
                  </div>

                  <div class="mt-6">
                    <div class="flex justify-end">
                      <a
                        href={`/styleguide/${e.id}/`}
                        target="_blank"
                        class="inline-flex min-h-11 items-center gap-1.5 text-sm text-muted underline-offset-4 hover:text-fg hover:underline"
                      >
                        Ouvrir seul dans un onglet
                        <Icon name="external-link" size={14} />
                      </a>
                    </div>
                    <div data-sg-viewport class="overflow-hidden rounded border border-border bg-surface">
                      <div data-sg-stage class="mx-auto overflow-hidden bg-bg">
                        <iframe
                          src={`/styleguide/${e.id}/`}
                          title={`Aperçu : ${e.doc.name}`}
                          loading="lazy"
                          class="block origin-top-left border-0"
                        />
                      </div>
                    </div>
                  </div>

                  <Accordion summary="Vue technique" class="mt-6">
                    <dl class="mt-3 grid gap-x-6 gap-y-3 text-sm sm:grid-cols-4">
                      <dt class="font-medium">{e.sectionType ? 'Type de section' : 'Identifiant'}</dt>
                      <dd class="sm:col-span-3"><code>{e.sectionType ?? e.id}</code></dd>
                      <dt class="font-medium">Fichier</dt>
                      <dd class="break-words sm:col-span-3"><code>{e.file}</code></dd>
                      <dt class="font-medium">Démo</dt>
                      <dd class="break-words sm:col-span-3"><code>{e.demoFile}</code></dd>
                      <dt class="font-medium">{e.sectionType ? 'Champs' : 'Props'}</dt>
                      <dd class="sm:col-span-3">
                        {e.fields.length === 0 ? (
                          <span class="text-muted">Aucun</span>
                        ) : (
                          <ul class="space-y-2">
                            {e.fields.map((f) => (
                              <li>
                                <code class="font-medium">
                                  {f.name}
                                  {f.optional && '?'}
                                </code>
                                <code class="ml-2 break-words text-muted">{f.type}</code>
                                {f.note && <p class="text-muted">{f.note}</p>}
                              </li>
                            ))}
                          </ul>
                        )}
                      </dd>
                      <dt class="font-medium">Variantes</dt>
                      <dd class="sm:col-span-3">
                        {e.variants.length === 0 ? (
                          <span class="text-muted">Aucune</span>
                        ) : (
                          e.variants.map((v) => (
                            <p>
                              <code>{v.name}</code> : {v.values.join(', ')}
                            </p>
                          ))
                        )}
                      </dd>
                      <dt class="font-medium">Pages qui l’utilisent</dt>
                      <dd class="sm:col-span-3">
                        {e.usedBy.length === 0 ? (
                          <span class="text-muted">Aucune pour l’instant</span>
                        ) : (
                          <ul class="space-y-1">
                            {e.usedBy.map((u) => (
                              <li>
                                {u.href ? (
                                  <a href={u.href} class="text-accent underline underline-offset-2">
                                    {u.label}
                                  </a>
                                ) : (
                                  u.label
                                )}
                              </li>
                            ))}
                          </ul>
                        )}
                      </dd>
                    </dl>
                  </Accordion>
                </article>
              ))}
            </section>
          ))
        }

        <p data-sg-empty hidden class="mt-10 text-muted">
          Aucun composant ne correspond. Essayez un autre mot, ou demandez au développeur du site un
          nouveau composant.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Recherche, bascule ordinateur / téléphone, hauteur des aperçus, copie.
  // Vanilla, sans dépendance (règle absolue 2) ; sans JS, tout reste lisible
  // (aperçus à hauteur par défaut, sommaire ouvert).
  const WIDTH = { desktop: 1280, phone: 390 } as const;
  type Mode = keyof typeof WIDTH;
  let mode: Mode = 'desktop';

  const frames = [...document.querySelectorAll<HTMLIFrameElement>('[data-sg-stage] iframe')];

  // Le cadre rend la page isolée à sa vraie largeur (donc ses vrais points de
  // rupture), puis la réduit à la colonne si elle est plus étroite.
  const layout = (frame: HTMLIFrameElement) => {
    const viewport = frame.closest<HTMLElement>('[data-sg-viewport]');
    const stage = frame.parentElement;
    if (!viewport || !stage) return;
    const width = WIDTH[mode];
    const scale = Math.min(1, viewport.clientWidth / width);
    const height = Number(frame.dataset.height ?? 240);
    frame.style.width = `${width}px`;
    frame.style.height = `${height}px`;
    frame.style.transform = `scale(${scale})`;
    stage.style.width = `${width * scale}px`;
    stage.style.height = `${height * scale}px`;
  };
  const layoutAll = () => frames.forEach(layout);

  window.addEventListener('message', (event) => {
    if (event.origin !== location.origin || event.data?.type !== 'sg-height') return;
    const frame = frames.find((f) => f.contentWindow === event.source);
    if (!frame) return;
    frame.dataset.height = String(event.data.height);
    layout(frame);
  });
  const column = document.querySelector('[data-sg-viewport]')?.closest('section')?.parentElement;
  if (column) new ResizeObserver(layoutAll).observe(column);
  layoutAll();

  const modeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-sg-mode]')];
  for (const button of modeButtons) {
    button.addEventListener('click', () => {
      mode = button.dataset.sgMode as Mode;
      for (const b of modeButtons) b.setAttribute('aria-pressed', String(b === button));
      layoutAll();
    });
  }

  // Recherche instantanée : tous les mots doivent apparaître, accents ignorés.
  const input = document.querySelector<HTMLInputElement>('#sg-search');
  const count = document.querySelector<HTMLElement>('[data-sg-count]');
  const empty = document.querySelector<HTMLElement>('[data-sg-empty]');
  const entries = [...document.querySelectorAll<HTMLElement>('[data-sg-entry]')];
  const items = new Map(
    [...document.querySelectorAll<HTMLElement>('[data-sg-item]')].map((li) => [li.dataset.sgItem, li]),
  );
  const groups = [...document.querySelectorAll<HTMLElement>('[data-sg-group]')];
  const norm = (s: string) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
  const countLabel = count?.textContent ?? '';

  const filter = () => {
    const terms = norm(input?.value ?? '').split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const entry of entries) {
      const hay = norm(entry.dataset.search ?? '');
      const match = terms.every((t) => hay.includes(t));
      entry.hidden = !match;
      const item = items.get(entry.id);
      if (item) item.hidden = !match;
      if (match && !entry.id.startsWith('fondations-')) shown++;
    }
    for (const group of groups) {
      group.hidden = !group.querySelector('[data-sg-entry]:not([hidden]), [data-sg-item]:not([hidden])');
    }
    if (count) count.textContent = terms.length ? `${shown} résultat${shown > 1 ? 's' : ''}` : countLabel;
    if (empty) empty.hidden = entries.some((e) => !e.hidden);
    layoutAll();
  };
  input?.addEventListener('input', filter);
  input?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && input.value) {
      input.value = '';
      filter();
    }
  });
  // « / » place le curseur dans la recherche (hors saisie en cours).
  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement;
    if (event.key !== '/' || target.closest('input, textarea, [contenteditable]')) return;
    event.preventDefault();
    input?.focus();
  });

  // Sommaire (Accordion) : ouvert sur grand écran, replié sur téléphone.
  const menu = document.querySelector<HTMLDetailsElement>('aside details');
  const wide = window.matchMedia('(min-width: 64rem)');
  const syncMenu = () => {
    if (menu) menu.open = wide.matches;
  };
  wide.addEventListener('change', syncMenu);
  syncMenu();
  menu?.addEventListener('click', (event) => {
    if (!wide.matches && (event.target as HTMLElement).closest('a')) menu.open = false;
  });

  // Copie de la phrase à dire : le libellé de repos est LU sur le bouton.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-sg-copy]')) {
    const idle = button.textContent ?? '';
    button.addEventListener('click', async () => {
      const text = button.parentElement?.querySelector('[data-sg-ask]')?.textContent?.trim() ?? '';
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copiée';
      } catch {
        button.textContent = 'Copie impossible';
      }
      setTimeout(() => (button.textContent = idle), 2000);
    });
  }
</script>
