---
// Page isolée d'un composant de la bibliothèque : /styleguide/<id>/.
// Affichée dans l'iframe de /styleguide (largeur basculée ordinateur /
// téléphone, donc vrais points de rupture) et ouvrable seule. Sans en-tête ni
// pied de page (chrome={false}). Absente de la production (GALLERY_ENABLED).
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/landing/SectionRenderer.astro';
import { GALLERY_ENABLED, getGallery, type GalleryEntry } from '@/lib/styleguide';

export async function getStaticPaths() {
  if (!GALLERY_ENABLED) return [];
  const { entries } = await getGallery();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: GalleryEntry;
}
const { entry } = Astro.props;
const { render } = entry;

const meta = {
  title: `${entry.doc.name} · Bibliothèque`,
  description: entry.doc.purpose,
  seo: { noindex: true },
};
---

<BaseLayout meta={meta} chrome={false}>
  {/* flow-root : contient les marges des enfants, donc la hauteur mesurée est la vraie. */}
  <div data-sg-frame class="flow-root">
    {
      render.kind === 'section' ? (
        <SectionRenderer section={render.example} />
      ) : (
        <div class="px-4 py-6">
          <render.Demo />
        </div>
      )
    }
  </div>
</BaseLayout>

<script>
  // Dans l'iframe de la bibliothèque : annonce la hauteur du contenu à la page
  // parente (même origine), qui ajuste le cadre. Ouverte seule : ne fait rien.
  const frame = document.querySelector<HTMLElement>('[data-sg-frame]');
  if (frame && window.parent !== window) {
    const post = () =>
      window.parent.postMessage(
        { type: 'sg-height', height: Math.ceil(frame.getBoundingClientRect().height) },
        location.origin,
      );
    new ResizeObserver(post).observe(frame);
  }
</script>
